Type: ae3.Package
Name: util.repository-acm
Info: Repository actions package (with repository installer)
Provides: \
	acm/util.repository-acm \
	acm/actions:actions \

Declares: \
	distro-image-sync:source-prepare-pull:repo:acm/util.repository-acm::git@github.com:acmcms/util.repository-acm.git \
	distro-image-sync:source-prepare-pull:list:.:sh-data/repository/remotes-list-acm.txt \
	magic-team:team-member:skillset/keeper-acm:* \
	magic-team:directory:eclipse-acm:ceiling-write:/Volumes/workspace/myx:* \
	magic-team:permissions:directory:eclipse-acm:allow-write:keeper-acm:acm*/** \
	magic-team:permissions:directory:eclipse-acm:allow-write:keeper-acm:impl-standard-skinners/** \
	magic-team:permissions:directory:eclipse-acm:allow-write:keeper-acm:unit-test/** \
	magic-team:permissions:namespace:acm:allow-write:keeper-acm \
	--distro-image-sync:source-prepare-pull:exec:.:sh-scripts/sync-all-sources-acm.sh \
	--distro-repository-sync:sh-scripts/sync-all-sources-acm.sh \

